Output setup.gif
Set Shell "bash"
Set FontFamily "FuraMono Nerd Font Mono"
Set FontSize 16
Set Width 1060
Set Height 820
Set Padding 20
Set Theme { "name": "Gruvbox Dark", "background": "#292929", "foreground": "#ebdbb2", "black": "#292929", "red": "#f77768", "green": "#b8bb26", "yellow": "#fabd2f", "blue": "#84a498", "magenta": "#d3859a", "cyan": "#8ec07b", "white": "#ebdbb2", "brightBlack": "#928374", "brightRed": "#f77768", "brightGreen": "#b8bb26", "brightYellow": "#fabd2f", "brightBlue": "#84a498", "brightMagenta": "#d3859a", "brightCyan": "#8ec07b", "brightWhite": "#ebdbb2", "selection": "#504945", "cursor": "#ebdbb2" }
Set TypingSpeed 55ms
Hide
Type "export HOME=@R@/home PS1='$ ' JIRA_E2E_BASE=http://127.0.0.1:18431 JIRA_E2E_LOG=@R@/open.log JIRA_NO_UPDATE_NOTIFIER=1 PATH=@R@/bin:$PATH && clear"
Enter
Sleep 500ms
Show
Sleep 600ms
Type "jira setup"
Sleep 600ms
Enter
Sleep 2s
Type "acme"
Sleep 900ms
Enter
Sleep 2s
Enter
Sleep 2.2s
Enter
Sleep 2.6s
Enter
Sleep 7s
Enter
Sleep 2.5s
Enter
Sleep 1.5s
Type "n"
Sleep 1.6s
Enter
Sleep 2s
Type "n"
Sleep 3.5s
